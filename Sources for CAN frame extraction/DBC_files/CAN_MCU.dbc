CM_ BU_ Dashboard "TMSturtle";
CM_ BU_ VCU "Vehicle Control Unit";
CM_ BU_ ADU "ECU Master Advanced Display Unit";
CM_ BU_ APU "Autonomous Processing Unit
";
CM_ BU_ BLDC "Steering Actuator Controller
";
CM_ BU_ ASB "Autonomous System Brake
";
CM_ BU_ Isabellen "IVT measurement unit
";
CM_ BO_ 803 "The measurements for rear suspension
";
CM_ SG_ 803 Susp_Pot_RL "Suspension Potentiometers Rear Left";
CM_ SG_ 803 Susp_Pot_RR "Suspension Potentiometers Rear Right";
CM_ BO_ 100 "APPS Raw Values & SCS states, Brake Pressure & SCS states";
CM_ SG_ 100 APPS_SC_Signals "checks if APPSs's signals are short circuited ";
CM_ SG_ 100 APPS_SC_Sup "checks if any of the APPS signal is short circuited to supply";
CM_ SG_ 100 APPS_SC_GND "checks if any of the APPS signal is short circuited to GND";
CM_ SG_ 100 APPS_Out_Of_Range "checks if any of APPSs' signals is out of range";
CM_ BO_ 800 "LEDs to Dashboard and bools from ECU to ASB and AUX";
CM_ SG_ 800 Buzzer "Signal to trigger Buzzer";
CM_ SG_ 800 Enable "Enable ON (R2D sequence done)";
CM_ SG_ 800 SafeState_OK "SafeState_OK == 1 means no SafeState error present. Sent by Fusebox.";
CM_ SG_ 800 AMS_Error_Latched "AMS Error Latched on Fusebox. If there is no AMS Error, Reset button must be pressed to delatch";
CM_ SG_ 800 IMD_Error_Latched "IMD Error Latched on Fusebox. If there is no IMD Error, Reset button must be pressed to delatch";
CM_ SG_ 800 Mode "Mode == 1: Manual. Mode == 0: Driverless.";
CM_ SG_ 800 AUX_AIR_Plus "AUX_AIR_Plus == 1 -> AIR+ is open.";
CM_ BO_ 102 "Steering Sensor";
CM_ SG_ 102 Steering "Steering Angle Sensor value in rad";
CM_ SG_ 102 Steering_Voltage "Steering sensor measured voltage
";
CM_ BO_ 103 "Dashboard buttons and toggle switches";
CM_ SG_ 103 Start "Start Button on Dashboard. Start == 1 if button pressed.";
CM_ SG_ 103 AddAct "AddAct Button signal, either from dashboard or external button, depending on vehicle Mode. AddAct == 1 if correct button pressed.";
CM_ SG_ 103 Setup "";
CM_ SG_ 103 Main_menu "Which place is chosen";
CM_ SG_ 103 Sub_menu "The current place at the secont column of the menu";
CM_ SG_ 103 Monitor "Monitor place";
CM_ SG_ 103 Cooling_status "Cooling enable";
CM_ SG_ 103 TS_Off "TS_Off analog signal received from Fusebox";
CM_ SG_ 103 Reset_SDC "External Reset button for SDC. Reset_SDC == 1 if button pressed.";
